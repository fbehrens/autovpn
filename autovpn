#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = ["boto3"]
# ///
"""autovpn - On Demand AWS OpenVPN Endpoint Deployment Tool.

Examples:
  autovpn -C -r us-east-1              create endpoint (keypair auto-generated)
  autovpn -S -r us-east-1              list running endpoints
  autovpn -T -r us-east-1 -z i-0abc    terminate endpoint
  autovpn -T -r us-east-1 -z all -y    terminate all endpoints in region
  autovpn -G -r us-east-1              generate keypair
  autovpn -D -r us-east-1 -k us-east-1_vpnkey   delete keypair
"""

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

import boto3
from botocore.exceptions import ClientError

ROOT = Path(__file__).resolve().parent
INSTALL_SCRIPT = ROOT / "scripts" / "openvpn-autoinstall.sh"
TAG = "auto_vpn"
GROUP_NAME = "vpn_2"
UBUNTU_AMI_NAME = "ubuntu/images/hvm-ssd-gp3/ubuntu-noble-24.04-{arch}-server-*"
CANONICAL = "099720109477"
SSH_OPTS = [
    "-o", "StrictHostKeyChecking=no",
    "-o", "UserKnownHostsFile=/dev/null",
    "-o", "LogLevel=ERROR",
    "-o", "ConnectTimeout=10",
    "-o", "IdentitiesOnly=yes",
]

GREEN, RED, YELLOW, RESET = "\033[32m", "\033[31m", "\033[33m", "\033[0m"


def say(msg, color=GREEN):
    print(f"{color}{msg}{RESET}", flush=True)


def die(msg):
    say(msg, RED)
    sys.exit(1)


def confirm(args, prompt):
    if args.yes:
        return True
    return input(f"{YELLOW}{prompt} [y/N] {RESET}").strip().lower() == "y"


def key_path(keyname):
    return Path.cwd() / f"{keyname}.pem"


def generate_key(ec2, keyname):
    path = key_path(keyname)
    if path.exists():
        say(f"Keypair file {path.name} already exists.", YELLOW)
        return path
    try:
        key = ec2.create_key_pair(KeyName=keyname, KeyType="ed25519")
    except ClientError as e:
        if e.response["Error"]["Code"] == "InvalidKeyPair.Duplicate":
            die(f"Keypair {keyname} exists in AWS but {path.name} is missing here.\n"
                f"Copy it from your old machine, or delete it with: autovpn -D -r <region> -k {keyname}")
        raise
    path.write_text(key["KeyMaterial"])
    path.chmod(0o600)
    say(f"Keypair {keyname} created: {path.name}")
    return path


def ensure_security_group(ec2, port):
    try:
        group_id = ec2.describe_security_groups(GroupNames=[GROUP_NAME])["SecurityGroups"][0]["GroupId"]
    except ClientError as e:
        if e.response["Error"]["Code"] != "InvalidGroup.NotFound":
            raise
        group_id = ec2.create_security_group(GroupName=GROUP_NAME, Description="A group that allows VPN access")["GroupId"]
    for proto, p in (("tcp", 22), ("udp", port)):
        try:
            ec2.authorize_security_group_ingress(
                GroupId=group_id, IpProtocol=proto, FromPort=p, ToPort=p, CidrIp="0.0.0.0/0")
        except ClientError as e:
            if e.response["Error"]["Code"] != "InvalidPermission.Duplicate":
                raise
    return group_id


def resolve_ami(ec2, instance_type):
    info = ec2.describe_instance_types(InstanceTypes=[instance_type])["InstanceTypes"][0]
    arch = "arm64" if "arm64" in info["ProcessorInfo"]["SupportedArchitectures"] else "amd64"
    images = ec2.describe_images(Owners=[CANONICAL], Filters=[
        {"Name": "name", "Values": [UBUNTU_AMI_NAME.format(arch=arch)]},
        {"Name": "state", "Values": ["available"]},
    ])["Images"]
    return max(images, key=lambda i: i["CreationDate"])["ImageId"]


def wait_for_ssh(ssh):
    for _ in range(60):
        r = subprocess.run([*ssh, "cloud-init status --wait >/dev/null; true"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if r.returncode == 0:
            return
        say("still booting...", YELLOW)
        time.sleep(5)
    die("Instance did not become reachable via ssh.")


def create(args, session, ec2):
    keyname = args.keyname or f"{args.region}_vpnkey"
    pem = key_path(keyname)
    if not pem.exists():
        pem = generate_key(ec2, keyname)

    group_id = ensure_security_group(ec2, args.port)
    ami = args.ami or resolve_ami(ec2, args.instance_type)
    say(f"Creating {args.instance_type} ({ami}) in {args.region}...", RESET)
    instance = session.resource("ec2").create_instances(
        ImageId=ami,
        InstanceType=args.instance_type,
        KeyName=keyname,
        SecurityGroupIds=[group_id],
        MinCount=1,
        MaxCount=1,
        MetadataOptions={"HttpTokens": "required"},
        TagSpecifications=[{"ResourceType": "instance", "Tags": [{"Key": "Name", "Value": TAG}, {"Key": TAG, "Value": ""}]}],
    )[0]
    instance.wait_until_running()
    instance.reload()
    ip = instance.public_ip_address
    say(f"Instance {instance.id} running at {ip}")

    ssh = ["ssh", *SSH_OPTS, "-i", str(pem), f"{args.user}@{ip}"]
    wait_for_ssh(ssh)

    say(f"Setting up OpenVPN on {ip}...", RESET)
    env = f"PORT={args.port} DNS='{args.dns}' DUPLICATE_CN={int(args.multi)}"
    with INSTALL_SCRIPT.open("rb") as script:
        r = subprocess.run([*ssh, f"sudo {env} bash -s"], stdin=script, capture_output=True, text=True)
    if r.returncode != 0:
        print(r.stdout[-3000:], r.stderr[-3000:])
        die(f"OpenVPN install failed. Debug with: ssh -i {pem.name} {args.user}@{ip}")

    out = Path.cwd() / f"{args.region}_aws_vpn.ovpn"
    config = subprocess.run([*ssh, "sudo cat /root/aws_vpn.ovpn"], capture_output=True, check=True).stdout
    out.write_bytes(config)
    docker_config = ROOT / "custom" / "default.ovpn"
    docker_config.parent.mkdir(exist_ok=True)
    docker_config.write_bytes(config)
    say(f"OpenVPN config written to {out} and {docker_config}")


def running_instances(ec2):
    pages = ec2.get_paginator("describe_instances").paginate(Filters=[
        {"Name": "tag-key", "Values": [TAG]},
        {"Name": "instance-state-name", "Values": ["pending", "running"]},
    ])
    return [i for page in pages for r in page["Reservations"] for i in r["Instances"]]


def status(args, ec2):
    instances = running_instances(ec2)
    if not instances:
        say(f"No instances running in {args.region}")
    for i in instances:
        print(f"{i['InstanceId']}\t{i['InstanceType']}\t{i.get('PublicIpAddress', '-')}\t{i['LaunchTime']:%Y-%m-%d %H:%M}")


def terminate(args, ec2):
    ids = [i["InstanceId"] for i in running_instances(ec2)] if args.instance_id == "all" else [args.instance_id]
    if not ids:
        return say(f"No instances running in {args.region}")
    say(f"WARNING: {', '.join(ids)} in {args.region} will be terminated.", YELLOW)
    if confirm(args, "Continue?"):
        ec2.terminate_instances(InstanceIds=ids)
        say(f"{', '.join(ids)} terminated.")


def delete_key(args, ec2):
    say(f"WARNING: keypair {args.keyname} in {args.region} will be deleted.", YELLOW)
    if confirm(args, "Continue?"):
        ec2.delete_key_pair(KeyName=args.keyname)
        say(f"{args.keyname} deleted. Remove {args.keyname}.pem yourself if no longer needed.")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    action = p.add_mutually_exclusive_group(required=True)
    action.add_argument("-C", dest="action", action="store_const", const="create", help="create VPN endpoint")
    action.add_argument("-S", dest="action", action="store_const", const="status", help="list running endpoints")
    action.add_argument("-T", dest="action", action="store_const", const="terminate", help="terminate endpoint (-z)")
    action.add_argument("-G", dest="action", action="store_const", const="keygen", help="generate keypair")
    action.add_argument("-D", dest="action", action="store_const", const="delkey", help="delete keypair (-k)")
    p.add_argument("-r", dest="region", required=True, help="AWS region, e.g. us-east-1")
    p.add_argument("-k", dest="keyname", help="keypair name (default: <region>_vpnkey)")
    p.add_argument("-i", dest="instance_type", default="t4g.micro", help="instance type (default: t4g.micro)")
    p.add_argument("-a", dest="ami", help="custom AMI (default: latest Ubuntu 24.04)")
    p.add_argument("-u", dest="user", default="ubuntu", help="ssh user (default: ubuntu)")
    p.add_argument("-p", dest="port", type=int, default=1194, help="OpenVPN UDP port (default: 1194)")
    p.add_argument("-d", dest="dns", default="1.1.1.1 9.9.9.9", help="DNS servers pushed to clients")
    p.add_argument("-m", dest="multi", action="store_true", help="allow multiple connections with same config")
    p.add_argument("-z", dest="instance_id", help="instance id to terminate, or 'all'")
    p.add_argument("-y", dest="yes", action="store_true", help="skip confirmations")
    args = p.parse_args()

    session = boto3.Session(region_name=args.region, profile_name=os.environ.get("AWS_PROFILE"))
    ec2 = session.client("ec2")
    match args.action:
        case "create":
            create(args, session, ec2)
        case "status":
            status(args, ec2)
        case "terminate":
            if not args.instance_id:
                p.error("-T requires -z <instance-id|all>")
            terminate(args, ec2)
        case "keygen":
            generate_key(ec2, args.keyname or f"{args.region}_vpnkey")
        case "delkey":
            if not args.keyname:
                p.error("-D requires -k <keyname>")
            delete_key(args, ec2)


if __name__ == "__main__":
    try:
        main()
    except ClientError as e:
        die(str(e))
    except KeyboardInterrupt:
        sys.exit(130)
